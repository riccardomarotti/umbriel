# Development package for the personal Umbriel fork.
# Based on the official Umbriel AUR packaging recipe.
# This file is intentionally kept on the development branch, not upstream.
pkgname=umbriel-orametra-git
pkgver=0.1.0.r0.0000000
pkgrel=1
epoch=1
pkgdesc='Umbriel Wayland compositor with experimental late-pose-latch effect pipeline'
arch=('x86_64' 'aarch64')
url='https://github.com/riccardomarotti/umbriel'
license=('MIT')
options=('!debug')
depends=(
  'cairo'
  'gcc-libs'
  'glibc'
  'jemalloc'
  'lcms2'
  'libdrm'
  'libdisplay-info'
  'libei>=1.3'
  'libglvnd'
  'libinput'
  'libxcb'
  'libxkbcommon'
  'mesa'
  'pango'
  'pixman'
  'systemd-libs'
  'tomlplusplus'
  'wayland'
  'xcb-util-wm'
  'xorg-xwayland'
  'xdg-desktop-portal-umbriel'
  'wlroots0.20>=0.20.1'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'wayland-protocols'
)
provides=('umbriel')
conflicts=('umbriel' 'umbriel-git')
source=('umbriel::git+https://github.com/riccardomarotti/umbriel.git#branch=feature/late-pose-latch')
b2sums=('SKIP')

pkgver() {
  cd "$srcdir/umbriel"
  local version
  version=$(tr -d '[:space:]' < VERSION)
  printf '%s.r%s.%s' \
    "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  arch-meson "$srcdir/umbriel" "$srcdir/umbriel/build" \
    -Db_ndebug=true \
    -Dtests=disabled \
    -Dharness=disabled
  meson compile -C "$srcdir/umbriel/build"
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/umbriel/build" --no-rebuild
  install -Dm644 "$srcdir/umbriel/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
